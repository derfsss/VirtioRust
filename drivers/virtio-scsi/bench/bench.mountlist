/* AmigaDiskBench: one SFS partition on each driver's 256 MB blank disk
   (bench-c.img, bench-r.img; 2048 cylinders of 256 blocks), same
   geometry, buffers and MaxTransfer on both. */
BC:
   /* the C driver: unit 1, target 1 on the system controller (SYSDISK2) */
   Device       = virtioscsi.device
   Unit         = 1
   Flags        = 0
   SectorSize   = 512
   Surfaces     = 1
   BlocksPerTrack = 256
   Reserved     = 2
   PreAlloc     = 0
   Interleave   = 0
   LowCyl       = 1
   HighCyl      = 2047
   Buffers      = 100
   BufMemType   = 0
   MaxTransfer  = 0x100000
   Mask         = 0xFFFFFFFE
   DosType      = 0x53465300
   StackSize    = 16384
   GlobVec      = -1
   Activate     = 1
#
BR:
   /* the Rust dev build: unit 0, the first disk on the test controller (TESTDISKS) */
   Device       = vscsirs.device
   Unit         = 0
   Flags        = 0
   SectorSize   = 512
   Surfaces     = 1
   BlocksPerTrack = 256
   Reserved     = 2
   PreAlloc     = 0
   Interleave   = 0
   LowCyl       = 1
   HighCyl      = 2047
   Buffers      = 100
   BufMemType   = 0
   MaxTransfer  = 0x100000
   Mask         = 0xFFFFFFFE
   DosType      = 0x53465300
   StackSize    = 16384
   GlobVec      = -1
   Activate     = 1
#
